# Database (Railway MySQL)
DB_HOST=your-railway-mysql-host
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=railway
DB_PORT=3306

# Server
PORT=5000

# JWT
JWT_SECRET=change-this-to-a-random-secret

# Frontend URL (for password reset links & CORS)
FRONTEND_URL=https://nforcepulse-frontend.vercel.app

# Extra CORS origins (comma-separated)
CORS_ORIGINS=
